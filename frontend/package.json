{
    "name": "annotation-hub-frontend",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "prettier --check . && eslint .",
        "format": "prettier --write .",
        "test": "vitest run --bail 1",
        "test:ui": "vitest --ui",
        "test:watch": "vitest --reporter=verbose",
        "build:docs": "typedoc"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@pnpm/eslint-config": "1100.0.0",
        "@sveltejs/adapter-auto": "7.0.1",
        "@sveltejs/kit": "^2.58.0",
        "@sveltejs/vite-plugin-svelte": "7.0.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/svelte": "5.3.1",
        "@testing-library/user-event": "14.6.1",
        "@tsconfig/svelte": "5.0.8",
        "@types/eslint": "9.6.1",
        "@typescript-eslint/eslint-plugin": "8.59.0",
        "@typescript-eslint/parser": "8.59.0",
        "@vitest/coverage-v8": "4.1.5",
        "@vitest/ui": "4.1.5",
        "eslint": "10.2.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-svelte": "3.17.1",
        "eslint-plugin-tsdoc": "0.5.2",
        "globals": "17.5.0",
        "jsdom": "29.1.0",
        "prettier": "3.8.3",
        "prettier-plugin-svelte": "3.5.1",
        "svelte": "^5.55.5",
        "svelte-check": "4.4.6",
        "typedoc": "^0.28.19",
        "typedoc-plugin-markdown": "^4.11.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.59.0",
        "typescript-eslint-language-service": "5.0.5",
        "vite": "^8.0.10",
        "vitest": "4.1.5"
    },
    "type": "module",
    "dependencies": {
        "@smui/card": "^8.0.3",
        "@sveltejs/adapter-node": "^5.5.4",
        "@types/jsdom": "28.0.1",
        "@types/node": "25.6.0",
        "bootstrap": "5.3.8",
        "dompurify": "^3.4.1",
        "fta-cli": "3.0.0",
        "halfmoon": "2.0.2",
        "immutable": "^5.1.5",
        "zod": "^4.3.6"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ],
        "overrides": {
            "cookie@<0.7.0": ">=0.7.0",
            "@sveltejs/kit@>=2.49.0 <=2.52.1": ">=2.52.2",
            "devalue@<=5.6.2": ">=5.6.3",
            "svelte@<=5.51.4": ">=5.51.5",
            "svelte@>=5.39.3 <5.51.5": ">=5.51.5",
            "minimatch@<3.1.3": ">=3.1.3",
            "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
            "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
            "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
            "minimatch@<3.1.4": ">=3.1.4",
            "@sveltejs/kit@>=2.49.0 <=2.53.2": ">=2.53.3",
            "ajv@<6.14.0": ">=6.14.0",
            "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
            "svelte@<=5.53.4": ">=5.53.5",
            "devalue@<5.6.4": ">=5.6.4",
            "devalue@<=5.6.3": ">=5.6.4",
            "flatted@<3.4.0": ">=3.4.0",
            "flatted@<=3.4.1": ">=3.4.2",
            "brace-expansion@<1.1.13": ">=1.1.13",
            "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
            "picomatch@<2.3.2": ">=2.3.2",
            "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
            "yaml@>=1.0.0 <1.10.3": ">=1.10.3",
            "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
            "vite@>=7.1.0 <=7.3.1": ">=7.3.2",
            "@sveltejs/kit@<=2.57.0": ">=2.57.1",
            "dompurify@<=3.3.3": ">=3.4.0",
            "dompurify@<3.4.0": ">=3.4.0",
            "dompurify@>=1.0.10 <3.4.0": ">=3.4.0",
            "dompurify@>=3.0.1 <3.4.0": ">=3.4.0",
            "postcss@<8.5.10": ">=8.5.10",
            "immutable@>=5.0.0 <5.1.5": ">=5.1.5"
        }
    },
    "prettier": {
        "tabWidth": 4
    }
}
